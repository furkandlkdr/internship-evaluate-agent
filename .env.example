# Supabase proje URL'si — public, tarayıcıda da kullanılır.
NEXT_PUBLIC_SUPABASE_URL=https://qgmqwozfbsxjaogvyrxe.supabase.co

# Supabase anon/public key — public, tarayıcıda da kullanılır.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key — SADECE sunucu tarafında kullanılır.
# Asla NEXT_PUBLIC_ önekiyle başlatma; asla istemciye açma.
# Bu anahtar, signed URL üretmek ve n8n'e eşdeğer yetki sağlamak için kullanılır.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# n8n webhook URL'si — public bir uç nokta, isteğe bağlı olarak geçersiz kılınabilir.
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://nafair.app.n8n.cloud/webhook/internship-application
